# Opt-in single-GPU COST adapter. Legacy infaas-docker.sh is unchanged.
PROJECT=taeho-infaas-single-gpu
WORKER_IMAGE=infaas-single-gpu:cost-v1
CONTAINER_NAME=infaas-single-gpu-worker-2
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
GPU=2
GPU_TYPE=v100
HW_COST=v100:1
APPLICATION=imagenet
MODEL_REGISTRY=deploy/docker/infaas-single-gpu.models.json
MODEL_DIR=data/infaas/models
DATA_DIR=data/infaas/single-gpu-cost-v1
INPUT_IMAGE=inputs/test-dog.jpg
TRACE_FILE=../Proteus/workloads/twitter-resnet-slo200.txt
PUBLISH_ADDR=127.0.0.1
QUERY_PORT=50052
REGISTER_PORT=50053
PREPROCESS_BACKEND=pil
CPU_THREADS=2
CPU_INTEROP_THREADS=1
# Preserve the legacy INFaaS request-handler concurrency, not a new CPU pool.
WORKER_THREADS=32
WARMUP_QUERIES=10
SLO_MS=200
BATCH_SIZES=1,2,4,8
PROFILE_RUNS=30
ALLOCATION_INTERVAL=1
EWMA_ALPHA=0.7
INITIAL_RATE=1
DEADLINE_GUARD_MS=2
MIN_ACCURACY=0
SLACK_THRESHOLD=1.05
LAMBDA=1.0
ALLOW_GPU_SHARING=0
