# Proteus/Clipper comparison: one V100, same pinned ResNet-50 and CPU processor.
# Copy to infaas-proteus-cpu.local.env; choose it with INFAAS_ENV.
GPUS=2:v100
HW_COST=v100:1
HW_TYPES=
CPUSETS=
PREPROCESS_BACKEND=pil
CPU_THREADS=2
CPU_INTEROP_THREADS=1
PREPROCESS_WORKERS=1
PREPROCESS_MODES=a30:gpu_only,l40s:gpu_only
MODEL_NAME=resnet-50
MODEL_REVISIONS=resnet-50:34c2154c194f829b11125337b98c8f5f9965ff19
INPUT_IMAGE=inputs/test-dog.jpg
SLO_MS=200
MODEL_DIR=data/infaas/models
# Separate profiles/logs; previous DALI results are never deleted.
PROFILE_DIR=data/infaas/proteus-cpu/cpu-ready-v1/profiles
LOG_DIR=data/infaas/proteus-cpu/cpu-ready-v1/logs
PROFILE_MODE=original
PROFILE_REQUIRE_PREPROCESS_MATCH=true
REQUIRE_CUDA=true
PROFILE_RUNS=30
PROFILE_SAT_SECONDS=5
PROFILE_SAT_CONCURRENCY=4
PYTHON_IMAGE=python:3.11-slim-bookworm
TORCH_VERSION=2.11.0+cu126
TORCHVISION_VERSION=0.26.0+cu126
INSTALL_DALI=0
CONTROLLER_IMAGE=infaas-controller:cpu-ready-v1
WORKER_IMAGE=infaas-worker:cpu-ready-v1
NETWORK=bridge
PUBLISH_ADDR=127.0.0.1
HOST_PORT_OFFSET=0
WORKER_BASE_PORT=9000
ROLE=all
CONTROLLER_HOST=
ADVERTISE_HOST=127.0.0.1
EXTRA_WORKERS=
DECISION_MODE=6
AUTOSCALER_TYPE=infaas
LAMBDA=1.0
SLACK_THRESHOLD=1.05
VM_UTIL_THRESHOLD=80
MONITOR_INTERVAL_S=2.0
MODEL_AUTOSCALER_INTERVAL_S=1.0
VM_AUTOSCALER_INTERVAL_S=2.0
EXEC_BLACKLIST_UTIL_ENABLED=false
EXEC_BLACKLIST_QPS_ENABLED=false
WARMUP_QUERIES=10
REQUEST_LOG=/logs/requests.jsonl
EVENT_LOG=/logs/events.jsonl
